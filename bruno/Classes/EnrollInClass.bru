meta {
  name: Enroll in Class
  type: http
  seq: 6
}

post {
  url: {{baseUrl}}/classes/enroll
  body: json
  auth: bearer
}

auth:bearer {
  token: {{authToken}}
}

body:json {
  "join_code": "A3BF92K1"
}

docs {
  Called when a student enters a join code shared by their teacher.
  The join_code is case-insensitive — "a3bf92k1" and "A3BF92K1" both work.

  Possible error responses:
    404 - No class found with that join code
    409 - Student is already enrolled in this class
}

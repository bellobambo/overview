meta {
  name: Get Assignments
  type: http
  seq: 5
}

get {
  url: {{baseUrl}}/assignments
  body: none
  auth: bearer
}

auth:bearer {
  token: {{authToken}}
}

docs {
  summary: Get assignments for the authenticated user.
  description: Teachers receive their own assignments. Students receive assignments from classes they belong to.
}

response {
  status: 200
  body: {
    "assignments": [
      {
        "id": "assignment-1",
        "class_id": "class-1",
        "title": "Essay",
        "description": "Write a 1000-word essay",
        "due_date": "2026-08-20",
        "word_limit": 1000,
        "ai_policy": "no-ai"
      }
    ]
  }
}

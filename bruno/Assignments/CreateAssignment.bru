meta {
  name: Create Assignment
  type: http
  seq: 6
}

post {
  url: {{baseUrl}}/assignments
  body: json
  auth: bearer
}

auth:bearer {
  token: {{authToken}}
}

body:json {
  "class_id": "class-1",
  "title": "Essay",
  "description": "Write a 1000-word essay",
  "due_date": "2026-08-20",
  "word_limit": 1000,
  "ai_policy": "no-ai"
}

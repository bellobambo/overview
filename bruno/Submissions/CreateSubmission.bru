meta {
  name: Create Submission
  type: http
  seq: 8
}

// POST /submissions
// Called immediately when a student opens an assignment in the editor.
// Only assignment_id is required — the rest default to empty strings and "draft".
// This gives us a submission_id right away to attach keystroke logs to.
// To create a final submission directly, pass status: "submitted".

post {
  url: {{baseUrl}}/submissions
  body: json
  auth: bearer
}

auth:bearer {
  token: {{authToken}}
}

body:json {
  "assignment_id": "your-assignment-uuid-here",
  "final_text": "",
  "final_html": "",
  "status": "draft"
}

  token: {{authToken}}
}

body:json {
  "assignment_id": "assignment-1",
  "final_text": "My submission",
  "final_html": "<p>My submission</p>"
}

docs {
  summary: Create a submission.
  description: Submits work for an assignment.
}

response {
  status: 201
  body: {
    "submission": {
      "id": "submission-2",
      "assignment_id": "assignment-1",

meta {
  name: Create Submission
  type: http
  seq: 8
}

post {
  url: {{baseUrl}}/submissions
  body: json
  auth: bearer
}

auth:bearer {
  token: {{authToken}}
}

body:json {
  "assignment_id": "your-assignment-uuid-here",
  "final_text": "",
  "final_html": "",
  "status": "draft"
}

docs {
  Called immediately when a student opens an assignment in the editor.
  Only assignment_id is required — final_text and final_html default to empty strings, status defaults to "draft".
  This returns a submission_id right away so keystroke logs can be attached to it.

  To create a final submission directly, pass status: "submitted".
}

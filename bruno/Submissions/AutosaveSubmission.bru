meta {
  name: Autosave Submission (Draft)
  type: http
  seq: 10
}

patch {
  url: {{baseUrl}}/submissions/your-submission-uuid-here
  body: json
  auth: bearer
}

auth:bearer {
  token: {{authToken}}
}

body:json {
  "final_text": "The causes of World War I were numerous and complex...",
  "final_html": "<p>The causes of World War I were numerous and complex...</p>",
  "status": "draft"
}

docs {
  Called every ~10 seconds by the editor to autosave the student's draft.
  Replace "your-submission-uuid-here" in the URL with the real submission UUID.

  status is optional:
  - Omit it (or pass "draft") during normal autosave
  - Pass "submitted" when the student clicks the final Submit button

  Security: Only the student who owns the submission can update it.
  Returns 409 if the submission has already been graded.
}

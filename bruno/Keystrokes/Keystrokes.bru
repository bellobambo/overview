meta {
  name: Save Keystrokes
  type: http
  seq: 9
}

post {
  url: {{baseUrl}}/keystrokes
  body: json
  auth: bearer
}

auth:bearer {
  token: {{authToken}}
}

body:json {
  "submission_id": "your-submission-uuid-here",
  "events": [
    {
      "type": "insert",
      "position": 0,
      "content": "The ",
      "length": 4,
      "timestamp": 1723240481000
    },
    {
      "type": "insert",
      "position": 4,
      "content": "causes",
      "length": 6,
      "timestamp": 1723240482500
    },
    {
      "type": "delete",
      "position": 3,
      "deletedContent": "s",
      "length": 1,
      "timestamp": 1723240484000
    },
    {
      "type": "paste",
      "position": 10,
      "content": "of World War I",
      "length": 14,
      "timestamp": 1723240490000
    }
  ]
}

docs {
  Called every ~10 seconds by the editor to flush the keystroke buffer in bulk.
  Each object in the events array represents one editor action.

  Supported event types: insert, delete, paste, replace

  Phase 3 event shape fields:
    position       - cursor index in the document at the time of the event
    content        - text that was inserted or pasted
    deletedContent - text that was removed (used on delete/replace events)
    length         - character count of the inserted or deleted content
    timestamp      - Unix epoch in milliseconds

  All fields are stored as JSONB — no DB schema changes required.
}

meta {
  name: Save Keystrokes
  type: http
  seq: 9
}

post {
  url: {{baseUrl}}/keystrokes
  body: json
  auth: bearer
}

auth:bearer {
  token: {{authToken}}
}

body:json {
  "submission_id": "submission-1",
  "events": [
    {
      // Valid event types usually include: "INSERT", "DELETE", "PASTE", "REPLACE"
      "type": "insert",
      "timestamp": "2026-08-06T10:00:00Z",
      "value": "a",
      "cursor_position": 1
    }
  ]
}
